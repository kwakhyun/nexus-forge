{
  "name": "nexus-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public battery manufacturing operations demo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.vercel.json",
    "lint": "turbo run lint && tsc -p tsconfig.vercel.json && node --check scripts/benchmark-performance.mjs && node --check scripts/benchmark-application.mjs && node --check scripts/verify-production.mjs",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@nexus/web",
    "storybook": "npm --workspace @nexus/web run storybook",
    "storybook:build": "npm --workspace @nexus/web run storybook:build",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "benchmark:application": "npm run build && node scripts/benchmark-application.mjs",
    "benchmark:chart:stress": "node scripts/benchmark-performance.mjs --raw-points 100000 --sampled-points 1800 --repetitions 20 --warmups 2 --cpu-throttle 4",
    "benchmark:stress:smoke": "npm run build && node scripts/benchmark-application.mjs --history-points 100000 --cpu-throttle 4 --runs 1 --seconds 5 --soak-seconds 0 --checkpoint-seconds 2",
    "benchmark:stress": "npm run build && node scripts/benchmark-application.mjs --history-points 100000 --cpu-throttle 4 --runs 3 --seconds 30 --soak-seconds 3600 --checkpoint-seconds 5 --soak-interaction-seconds 300"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
